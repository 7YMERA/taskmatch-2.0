# TaskMatch API — environment template.
# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit the real .env — it is git-ignored.

# --- Supabase (required) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Publishable / anon key (safe for the public client).
SUPABASE_KEY=
# Service-role (secret) key — grants admin powers, bypasses row-level security.
# Only set this on the server. NEVER expose it to the browser. Optional:
# leave blank and the admin endpoints return 503 instead of misbehaving.
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS (optional) ---
# Comma-separated list of allowed frontend origins, e.g.
# CORS_ORIGINS=https://taskmatch-umber.vercel.app,http://localhost:3000
# Defaults to "*" (any origin) if unset.
CORS_ORIGINS=*
