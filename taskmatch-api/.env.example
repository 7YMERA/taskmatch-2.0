# TaskMatch API — environment template.
# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit the real .env — it is git-ignored.

# --- Supabase (required) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Publishable / anon key (safe for the public client).
SUPABASE_KEY=
# Service-role (secret) key — grants admin powers, bypasses row-level security.
# Only set this on the server. NEVER expose it to the browser. Required once
# row-level security is on (supabase/rls.sql): table queries use it.
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS (recommended) ---
# Comma-separated list of allowed frontend origins, e.g.
# CORS_ORIGINS=https://taskmatch-umber.vercel.app,http://localhost:3000
# If UNSET, no cross-origin requests are allowed (locked down).
# Set to "*" only to deliberately open the API to any origin.
# On Vercel the site and API share one domain (/api), so production needs no CORS;
# this is for local dev (and Render, if you still use it).
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (optional) ---
# Max requests per client IP per minute. Default 120; 0 turns it off.
# RATE_LIMIT_PER_MINUTE=120
